# Medicine portal (frontend-mr) - runs on 3004.
# Shared across the Indian Health System platform.

NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_APP_NAME=Indian Health System - Medicine Portal
NEXT_PUBLIC_ENV=development

# Google Identity client id (public). Leave blank to hide the Google button.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Google Maps JavaScript API key (public). SAME platform key the patient,
# doctor, admin and clinic portals use — powers the Google location search on
# MR / Medicine Store registration. Enable Maps JavaScript API + Places API +
# Geocoding API; restrict the key by HTTP referrer. Blank = plain-text fallback.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Shared parent domain for auth cookies (single sign-on across the apps).
NEXT_PUBLIC_COOKIE_DOMAIN=localhost

# The other apps in the platform.
NEXT_PUBLIC_PATIENT_URL=http://localhost:3000
NEXT_PUBLIC_DOCTOR_URL=http://doctor.localhost:3001
NEXT_PUBLIC_ADMIN_URL=http://admin.localhost:3002
NEXT_PUBLIC_CLINIC_URL=http://clinic.localhost:3003
NEXT_PUBLIC_MR_URL=http://localhost:3004
